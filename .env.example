# Application Configuration
APP_NAME=Multi-Agentic Chatbot
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# LLM Configuration
# Supported providers: openai, anthropic, gemini
# Example for Gemini:
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-1.5-mini
LLM_PROVIDER=openai
LLM_MODEL=gpt-4
LLM_API_KEY=your-api-key-here
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=30

# Database Configuration
DB_TYPE=sqlite
DB_URL=sqlite:///./app.db

# Redis Configuration
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Vector Store Configuration
VECTORSTORE_TYPE=pinecone
VECTORSTORE_API_KEY=your-vectorstore-api-key

# Logging Configuration
LOG_LEVEL=INFO
LOG_DIR=logs

# Security
SECRET_KEY=your-secret-key-change-in-production
CORS_ORIGINS=["*"]

# Timeouts and Limits
REQUEST_TIMEOUT=30
MAX_CONVERSATION_HISTORY=50
